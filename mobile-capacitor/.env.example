# Environment Configuration Template for Mobile Capacitor App
# Copy this file to .env and replace placeholder values with your actual configuration

# API Configuration
# For local development:
# - Emulator/Simulator: use http://localhost:5000/api or http://10.0.2.2:5000/api (Android emulator)
# - Physical Android device: use your computer's LAN IP address (e.g., http://192.168.1.100:5000/api)
#   Find your LAN IP: ipconfig (Windows) or ifconfig (Mac/Linux)
VITE_API_BASE_URL=http://localhost:5000/api
